[Unit]
Description=Sol-H3 worker watchdog: restart H200 workers that are down (see /home/jeff/sol-h3-h200/deployment/watchdog/README.md)
# ~/.config/systemd/user is on the shared /home; run only on the gateway host.
ConditionHost=VM-187-fukushimadc

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/jeff/sol-h3-h200/deployment/watchdog/watchdog.py
TimeoutStartSec=20min
